# Copy to .env (gitignored) and fill in. Never commit real keys.
GOOGLE_API_KEY=

# Local `livekit-server --dev` defaults. Only needed for `dev` / `start`, not for `console`.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

GEMINI_MODEL=gemini-3.8-live-extended-thinking
# MINIMAL | LOW | MEDIUM | HIGH. Higher = deeper follow-ups, slower turn-taking.
THINKING_LEVEL=HIGH
VOICE=Charon

# Turn detection. Raise VAD_PREFIX_MS if background noise still interrupts; raise VAD_SILENCE_MS if it
# cuts in while you pause to think.
VAD_PREFIX_MS=300
VAD_SILENCE_MS=1200

# Mock mode: qa/ sections for theory questions (system design 08 and behavioral 15 are always added).
INTERVIEW_SECTIONS=01,02,03,04,05,07,09,10
THEORY_QUESTIONS=6
DIAGNOSTIC_QUESTIONS=8
REVIEW_ITEMS=6

# Post-session report model. The report is written in the session language.
REPORT_MODEL=gemini-3.8-flash

# `agent.py console` only (the web UI picks these per session): mock | diagnostic | review.
INTERVIEW_MODE=mock
INTERVIEW_LANGUAGE=English
# Set to reproduce the same question set.
INTERVIEW_SEED=
